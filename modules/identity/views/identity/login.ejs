<%# ID-2: log in. Locals: action (keeps ?next=), values, alert, personas (development only). -%>
<% if (alert) { -%>
<p class="alert" role="alert"><%= alert %></p>
<% } -%>
<form class="form" method="post" action="<%= action %>">
  <%- csrfField() %>
  <div class="group">
    <%- include('partials/field', field({ name: 'email', type: 'email', label: 'University e-mail', value: values.email, autocomplete: 'username' })) %>
    <%- include('partials/field', field({ name: 'password', type: 'password', label: 'Password', autocomplete: 'current-password' })) %>
  </div>
  <button class="btn btn-cta" type="submit">Log in</button>
</form>
<div class="auth-links">
  <a href="/auth/forgot">Forgot password?</a>
  <a href="/auth/register">New here? Join with your university e-mail</a>
</div>
<% if (personas.length) { -%>
<h2 class="group-title">Developer shortcuts</h2>
<%- include('partials/menu', { groups: [personas] }) %>
<% } -%>
