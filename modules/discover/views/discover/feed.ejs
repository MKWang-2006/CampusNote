<section class="discover-feed stack" aria-labelledby="feed-heading">
  <%- include('partials/tabs', { items: feedTabs, label: 'Feed filters' }) %>
  <h2 class="small muted" id="feed-heading"><%= feedHeading %></h2>
<% if (cards.length) { -%>
  <%- include('partials/post-list', { cards, nextUrl, empty: emptyText }) %>
<% } else { -%>
  <%- include('partials/empty', { text: emptyText, href: canCompose ? '/compose' : null, label: canCompose ? 'Write a post' : null }) %>
<% } -%>
</section>
