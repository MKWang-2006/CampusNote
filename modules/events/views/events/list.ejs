<% if (canOrganize) { -%>
<nav class="row-between event-toolbar" aria-label="Event options">
  <a href="<%= mine ? '/events' : '/events?mine=1' %>"><%= mine ? 'All events' : 'My events' %></a>
  <a class="btn btn-sm" href="/events/new">New event</a>
</nav>
<% } -%>
<% if (!events.length) { -%>
<%- include('partials/empty', { text: mine ? 'You have not created an event yet.' : 'No upcoming events yet.', icon: 'calendar', href: mine ? '/events/new' : null, label: mine ? 'New event' : null }) %>
<% } else { -%>
<div class="page-grid events-list">
<% events.forEach((event) => { -%>
  <article class="card event-card" data-event-id="<%= event.event_id %>">
    <a class="event-card-link" href="/events/<%= event.event_id %>">
<% if (event.cover_path) { -%>
      <img class="event-cover" src="<%= event.cover_path %>" alt="" loading="lazy">
<% } else { -%>
      <div class="event-cover event-cover-empty"><%- ui.icon('calendar') %></div>
<% } -%>
      <h2><%= event.title %></h2>
      <p class="muted"><%= event.organizer_name %></p>
      <p><%= event.venue %></p>
      <p class="small"><time datetime="<%= event.starts_at.toISOString() %>"><%= ui.hkt(event.starts_at, true) %> HKT</time></p>
      <%- include('events/status', { event }) %>
    </a>
<% if (mine) { -%>
    <p class="small"><%= event.sold %> / <%= event.capacity %> sold · <%= event.checked_in %> checked in</p>
    <a href="/events/<%= event.event_id %>/attendees">Attendees</a>
<% } else if (event.booked_by_me) { -%>
    <p class="event-booked">✓ Booked</p>
<% } -%>
  </article>
<% }) -%>
</div>
<% } -%>
