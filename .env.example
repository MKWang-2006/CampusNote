# Copy to .env and fill in. .env is git-ignored; never commit it.
PORT=3000
NODE_ENV=development

# MySQL 8.0.19 or later (8.4 LTS recommended). The user needs all privileges on both databases.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_notes
DB_NAME_TEST=campus_notes_test

# Any long random string (signs the session cookie).
SESSION_SECRET=change-me-to-a-long-random-string

# Where uploaded images are stored (served at /uploads).
UPLOAD_DIR=uploads

# Optional: send real e-mail. The dev mailbox then lists each mail without its text.
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM=Campus Notes <no-reply@example.com>
